1 ICON "res/app.ico"
#include <winver.h>
#include "../src/version.h"   // APP_VERSION_NUM / APP_VERSION_STR / APP_VERSION_TAG

1 RT_MANIFEST "res\\app.manifest"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION    APP_VERSION_NUM
    PRODUCTVERSION APP_VERSION_NUM
    FILEFLAGSMASK  0x3fL
    FILEFLAGS      0x0L
    FILEOS         0x40004L
    FILETYPE       0x1L
    FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "冥零"
            VALUE "FileDescription",  "冥零工作台 - 内嵌 HTML 界面"
            VALUE "FileVersion",      APP_VERSION_STR
            VALUE "InternalName",     "MinglingWorkbench"
            VALUE "OriginalFilename", "MinglingWorkbench.exe"
            VALUE "ProductName",      "冥零工作台"
            VALUE "ProductVersion",   APP_VERSION_TAG
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END

200 RCDATA "web/index.html"
201 RCDATA "../art/hero.png"
202 RCDATA "../art/avatar.png"
