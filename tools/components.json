    "workspace": "工作区（默认同 base）",
    "bots": "组件根（默认 <workspace>\\bots）",
    "sidecar": "sidecar 目录（默认 <base>\\sidecar，尊重 MINGLING_SIDECAR）",
    "repo": "本脚本所在仓库根（tools 的上一级）",
    "astrbot_data": "AstrBot 数据目录（后台配置优先，否则 <bots>\\AstrBot\\data）"
  },
