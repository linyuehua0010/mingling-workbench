      "id": "astrbot",
      "name": "AstrBot",
      "version": "4.29.4",
      "requires": [
        "python",
        "uv"
      ],
      "optional": false,
      "default_install": true,
      "manual": false,
      "detect": {
        "kind": "command",
        "exe": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "{repo}\\tools\\verify-astrbot.ps1",
          "-Root",
          "{bots}\\AstrBot",
          "-RequireRunning"
        ],
        "expect_exit": 0,
        "timeout": 90
      },
      "source": {
        "kind": "uv-lock",
        "url": "https://files.pythonhosted.org/packages/b2/82/e7834f2b0f3347c2f7bef532ee7ecfea780a79df143016efd9442ab65075/astrbot-4.29.4-py3-none-any.whl",
        "urls": [
          "https://files.pythonhosted.org/packages/b2/82/e7834f2b0f3347c2f7bef532ee7ecfea780a79df143016efd9442ab65075/astrbot-4.29.4-py3-none-any.whl"
        ],
        "sha256": "53d20a66ed025b7305db0227dcf02d1d5d5c8456cda436cf31ba0d2817f44317",
        "package_sha256": "189e9b07bff6fb91fe0ebaa3e9273af6b028f190023dcc43cbbbe4d3ec00a5b5",
        "lock": "tools\\astrbot-requirements.txt",
        "trust": "PyPI 4.29.4 wheel + uv 生成的 Windows x64/Python 3.12 全依赖锁；每个发行包及构建依赖均有 sha256"
      },
      "install": {
        "steps": [
          {
            "kind": "uv_tool",
            "package": "astrbot",
            "uv_exe": "{base}\\uv\\bin\\uv.exe",
            "tool_dir": "{bots}\\AstrBot\\tools\\astrbot",
            "bin_dir": "{bots}\\AstrBot\\bin",
            "python_dir": "{bots}\\AstrBot\\python",
            "python_exe": "{bots}\\AstrBot\\python\\python.exe",
            "requirements": "{repo}\\tools\\astrbot-requirements.txt",
            "requirements_sha256": "53d20a66ed025b7305db0227dcf02d1d5d5c8456cda436cf31ba0d2817f44317",
            "needs_network": true
          },
          {
            "kind": "command",
            "exe": "{bots}\\AstrBot\\bin\\astrbot.exe",
            "args": [
              "init",
              "--yes"
            ],
            "workdir": "{bots}\\AstrBot",
            "timeout": 300
          },
          {
            "kind": "mkdir",
            "paths": [
              "{bots}\\AstrBot\\data",
              "{bots}\\AstrBot\\data\\config"
            ]
          },
          {
            "kind": "write_file",
            "path": "{bots}\\AstrBot\\env.cmd",
            "encoding": "ansi",
            "content": "@echo off\r\nset UV_TOOL_DIR={bots}\\AstrBot\\tools\r\nset UV_TOOL_BIN_DIR={bots}\\AstrBot\\bin\r\nset UV_PYTHON_INSTALL_DIR={bots}\\AstrBot\\python\r\n"
          },
          {
            "kind": "write_file",
            "path": "{bots}\\AstrBot\\start.cmd",
            "encoding": "ansi",
            "content": "@echo off\r\ncd /d \"{bots}\\AstrBot\"\r\nif exist \"{base}\\secrets\\deepseek-key.txt\" set /p MINGLING_DEEPSEEK_KEY=<\"{base}\\secrets\\deepseek-key.txt\"\r\nif not defined MINGLING_DEEPSEEK_KEY if exist \"{base}\\private\\deepseek-key.txt\" set /p MINGLING_DEEPSEEK_KEY=<\"{base}\\private\\deepseek-key.txt\"\r\nif not exist .astrbot \"{bots}\\AstrBot\\bin\\astrbot.exe\" init --yes >> data\\run.log 2>&1\r\n\"{bots}\\AstrBot\\bin\\astrbot.exe\" run --port 6185 >> data\\run.log 2>&1\r\n"
          },
          {
            "kind": "command",
            "exe": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "{repo}\\tools\\start-astrbot.ps1",
              "-Root",
              "{bots}\\AstrBot",
              "-Base",
              "{base}"
            ],
            "timeout": 300
          }
        ]
      },
      "verify": {
        "kind": "command",
        "exe": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "{repo}\\tools\\verify-astrbot.ps1",
          "-Root",
          "{bots}\\AstrBot",
          "-RequireRunning"
        ],
        "expect_exit": 0,
        "timeout": 90
      },
      "notes": "固定 4.29.4 全依赖锁；init 幂等且不覆盖已有 data/config；verify 检查 .astrbot、固定解释器、实际后台进程所属目录和 6185 响应，不把 --help 当成功。"
    },
